# Application
APP_NAME=Umbra Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./umbra.db
# Render production: set DATABASE_URL to the Postgres Internal Database URL.
# Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
MAX_INGESTION_ATTEMPTS=3

# Configure integration credentials before using their endpoints
PINECONE_API_KEY=
PINECONE_INDEX_NAME=umbra-assistant
PINECONE_ENVIRONMENT=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_EMBEDDING_MODEL=
HUGGINGFACE_EMBEDDING_DIM=1024
HUGGINGFACE_SYNTHESIS_MODEL=
# Hosted chat model ID (must be available through your chosen inference provider).
HUGGINGFACE_INFERENCE_PROVIDER=auto
BRIEF_AI_ENABLED=true
BRIEF_LLM_TIMEOUT_SECONDS=15

# Webhooks and Google OAuth
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SENDGRID_INBOUND_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local credential storage
# On Render, remove this override to use DATABASE_URL, or set the same Postgres URL.
CREDENTIAL_DB_URL=sqlite:///./credentials.db
CREDENTIAL_ENCRYPTION_KEY=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Retention
MESSAGE_TTL_DAYS=90
SUMMARY_TTL_DAYS=730
