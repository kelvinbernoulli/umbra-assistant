# Application
APP_NAME=Umbra Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./umbra.db
MAX_INGESTION_ATTEMPTS=3

# Leave integrations unset for local mock mode
PINECONE_API_KEY=
PINECONE_INDEX_NAME=umbra-assistant
PINECONE_ENVIRONMENT=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_EMBEDDING_MODEL=
HUGGINGFACE_EMBEDDING_DIM=1024
HUGGINGFACE_SYNTHESIS_MODEL=

# Webhooks and Google OAuth
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SENDGRID_INBOUND_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local credential storage
CREDENTIAL_DB_URL=sqlite:///./credentials.db
CREDENTIAL_ENCRYPTION_KEY=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Retention
MESSAGE_TTL_DAYS=90
SUMMARY_TTL_DAYS=730